#!/bin/bash

# Board Game Tracker CLI Tool
# Usage: ./bgt [start|stop|status|logs|restart]

# Get the directory of this script
DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"

# Colors for output
GREEN='\033[0;32m'
BLUE='\033[0;34m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Function to check if a port is in use
check_port() {
    if lsof -Pi :$1 -sTCP:LISTEN -t >/dev/null ; then
        return 0
    else
        return 1
    fi
}

case "$1" in
    install)
        echo -e "${BLUE}========================================${NC}"
        echo -e "${BLUE}   Board Game Tracker - Installation    ${NC}"
        echo -e "${BLUE}========================================${NC}"
        
        # Check for Python
        if ! command -v python3 &> /dev/null; then
            echo -e "${RED}Error: Python 3 is not installed!${NC}"
            echo "Please install Python 3 first:"
            echo "  Ubuntu/Debian: sudo apt install python3 python3-pip python3-venv"
            echo "  Fedora: sudo dnf install python3 python3-pip"
            echo "  Arch: sudo pacman -S python python-pip"
            exit 1
        fi
        
        # Check for Node.js
        if ! command -v node &> /dev/null; then
            echo -e "${RED}Error: Node.js is not installed!${NC}"
            echo "Please install Node.js first:"
            echo "  Ubuntu/Debian: sudo apt install nodejs npm"
            echo "  Fedora: sudo dnf install nodejs npm"
            echo "  Arch: sudo pacman -S nodejs npm"
            echo "  Or visit: https://nodejs.org/"
            exit 1
        fi
        
        # Check for lsof
        if ! command -v lsof &> /dev/null; then
            echo -e "${YELLOW}Warning: lsof is not installed!${NC}"
            echo "Installing lsof is recommended:"
            echo "  Ubuntu/Debian: sudo apt install lsof"
            echo "  Fedora: sudo dnf install lsof"
            echo "  Arch: sudo pacman -S lsof"
        fi
        
        echo -e "\n${GREEN}✓ System requirements satisfied${NC}"
        
        # Backend setup
        echo -e "\n${BLUE}Setting up Backend...${NC}"
        cd $DIR/backend
        
        # Create virtual environment
        if [ ! -d "venv" ]; then
            echo "Creating Python virtual environment..."
            python3 -m venv venv
        fi
        
        # Activate and install dependencies
        source venv/bin/activate
        echo "Installing Python packages..."
        pip install --upgrade pip
        pip install -r requirements.txt
        
        # Setup .env file
        if [ ! -f ".env" ]; then
            echo -e "\n${YELLOW}Creating .env file...${NC}"
            cp .env.example .env
            echo -e "${RED}IMPORTANT: Edit backend/.env and add your ANTHROPIC_API_KEY${NC}"
            echo "You can get an API key from: https://console.anthropic.com/"
        else
            echo -e "${GREEN}✓ .env file already exists${NC}"
        fi
        
        # Create database and run migrations
        echo "Initializing database..."
        python -c "from app import app, db; app.app_context().push(); db.create_all(); print('✓ Database created')"
        
        echo "Running database migrations..."
        python migrate.py migrate
        
        deactivate
        cd ..
        
        # Frontend setup
        echo -e "\n${BLUE}Setting up Frontend...${NC}"
        cd $DIR/frontend
        
        echo "Installing npm packages (this may take a few minutes)..."
        npm install
        
        cd ..
        
        echo -e "\n${GREEN}========================================${NC}"
        echo -e "${GREEN}   Installation Complete!               ${NC}"
        echo -e "${GREEN}========================================${NC}"
        echo -e "\n${YELLOW}Next steps:${NC}"
        echo "1. Edit backend/.env and add your ANTHROPIC_API_KEY"
        echo "2. Run: ./bgt start"
        echo -e "\n${BLUE}The application will be available at:${NC}"
        echo "   Frontend: http://localhost:3000"
        echo "   Backend API: http://localhost:5002"
        ;;
    
    start)
        $DIR/start.sh
        ;;
    
    start-bg)
        echo -e "${BLUE}Starting Board Game Tracker in background...${NC}"
        $DIR/start-bg.sh
        sleep 3
        if check_port 5002 && check_port 3000; then
            echo -e "${GREEN}✓ Board Game Tracker started successfully!${NC}"
            echo -e "${GREEN}✓ Backend API: http://localhost:5002${NC}"
            echo -e "${GREEN}✓ Frontend UI: http://localhost:3000${NC}"
            echo -e "\n${BLUE}Use './bgt logs' to view logs${NC}"
            echo -e "${BLUE}Use './bgt status' to check status${NC}"
            echo -e "${BLUE}Use './bgt stop' to stop servers${NC}"
        else
            echo -e "${RED}Error: Failed to start servers in background${NC}"
            echo -e "Try './bgt start' to see error messages"
        fi
        ;;
    
    stop)
        $DIR/stop.sh
        ;;
    
    restart)
        echo -e "${YELLOW}Restarting Board Game Tracker...${NC}"
        $DIR/stop.sh
        sleep 2
        $DIR/start.sh
        ;;
    
    status)
        echo -e "${BLUE}Board Game Tracker Status:${NC}"
        echo ""
        
        if check_port 5002; then
            echo -e "Backend API:  ${GREEN}● Running${NC} (http://localhost:5002)"
        else
            echo -e "Backend API:  ${RED}○ Stopped${NC}"
        fi
        
        if check_port 3000; then
            echo -e "Frontend UI:  ${GREEN}● Running${NC} (http://localhost:3000)"
        else
            echo -e "Frontend UI:  ${RED}○ Stopped${NC}"
        fi
        ;;
    
    logs)
        if [ "$2" == "backend" ]; then
            tail -f $DIR/backend.log
        elif [ "$2" == "frontend" ]; then
            tail -f $DIR/frontend.log
        else
            echo "Following both backend and frontend logs (Ctrl+C to stop)..."
            tail -f $DIR/backend.log $DIR/frontend.log
        fi
        ;;
    
    *)
        echo "Board Game Tracker CLI"
        echo ""
        echo "Usage: $0 {install|start|start-bg|stop|restart|status|logs [backend|frontend]}"
        echo ""
        echo "Commands:"
        echo "  install   - Install all dependencies and set up the application"
        echo "  start     - Start both servers (shows logs, blocks terminal)"
        echo "  start-bg  - Start both servers in background (recommended for development)"
        echo "  stop      - Stop all servers"
        echo "  restart   - Restart all servers"
        echo "  status    - Show server status"
        echo "  logs      - Show logs (optionally specify backend or frontend)"
        echo ""
        echo "Examples:"
        echo "  $0 install    # First time setup"
        echo "  $0 start-bg   # Start in background (recommended)"
        echo "  $0 start      # Start with logs visible"
        echo "  $0 status     # Check if running"
        echo "  $0 logs backend  # View backend logs"
        exit 1
        ;;
esac